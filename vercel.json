{
  "version": 2,
  "builds": [
    {
      "src": "api/app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/app.js"
    },
    {
      "src": "/about",
      "dest": "/PAGES/about.html"
    },
    {
      "src": "/contact",
      "dest": "/PAGES/contact.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}